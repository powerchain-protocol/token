{
  "name": "@powerchain/native-token-workspace",
  "version": "1.0.0-rc.0",
  "private": true,
  "description": "PTK-001 PWRC native-token program, SPL Token-2022 clients, metadata and public assets",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "attest:supply:devnet": "pnpm env:bootstrap:devnet && node scripts/attest-supply.mjs .env.devnet devnet",
    "attest:supply:production": "node scripts/attest-supply.mjs .env.production production",
    "build": "pnpm sync:web-public && pnpm -r build",
    "build:faucet": "pnpm --filter @powerchain/faucet build",
    "build:powerpay": "node scripts/run-rust-tool.mjs build-sbf programs/powerpay/Cargo.toml --features program",
    "build:program:mainnet": "node scripts/run-rust-tool.mjs build-sbf programs/native-token/Cargo.toml --features program,mainnet-beta",
    "build:program:sbf": "node scripts/run-rust-tool.mjs build-sbf programs/native-token/Cargo.toml --features program",
    "build:standards": "pnpm --filter @powerchain/standards build",
    "build:utils": "pnpm --filter @powerchain/utils build",
    "build:web": "pnpm sync:web-public && pnpm --filter @powerchain/web build",
    "check": "pnpm typecheck && pnpm test && pnpm validate",
    "check:all": "pnpm typecheck && pnpm test && pnpm validate:workspace && pnpm security:check",
    "check:devnet-token": "pnpm env:bootstrap:devnet && pnpm validate:devnet && pnpm test:tpwrc",
    "check:faucet": "pnpm --filter @powerchain/faucet typecheck && pnpm --filter @powerchain/faucet test",
    "check:programs": "pnpm validate:powerpay && pnpm test:program:rust && pnpm test:powerpay",
    "check:quick": "pnpm validate:workspace && node --test tests/*.test.mjs",
    "check:standards": "pnpm --filter @powerchain/standards typecheck && pnpm --filter @powerchain/standards test",
    "check:utils": "pnpm --filter @powerchain/utils typecheck && pnpm --filter @powerchain/utils test",
    "ci": "pnpm check && pnpm security:check && pnpm prepare:release",
    "clean": "pnpm -r clean",
    "deploy:devnet:check": "pnpm validate && pnpm validate:devnet",
    "deploy:production:check": "pnpm validate && pnpm security:check && pnpm validate:production && pnpm prepare:release",
    "dev": "pnpm dev:web",
    "dev:doctor": "node scripts/doctor.mjs && node scripts/check-workspace-install.mjs",
    "dev:faucet": "pnpm --filter @powerchain/faucet dev",
    "dev:web": "pnpm sync:web-public && pnpm --filter @powerchain/web dev",
    "doctor": "node scripts/doctor.mjs",
    "health:devnet": "node scripts/health-check.mjs .env.devnet devnet",
    "health:production": "node scripts/health-check.mjs .env.production production",
    "mainnet:check": "node scripts/validate-mainnet-integrations.mjs",
    "metadata:check": "pnpm metadata:generate -- --check && pnpm metadata:validate",
    "metadata:generate": "node scripts/generate-metadata.mjs && node scripts/sync-web-public.mjs",
    "metadata:validate": "node scripts/validate-metadata.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "recover": "bash scripts/recover-workspace.sh",
    "rehearsal:devnet:plan": "node scripts/devnet-rehearsal.mjs",
    "rehearsal:devnet:record": "node scripts/record-devnet-evidence.mjs",
    "release:evidence": "node scripts/validate-evidence.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:status": "node scripts/release-status.mjs",
    "release:status:strict": "node scripts/release-status.mjs --strict",
    "scripts:list": "node scripts/help.mjs",
    "security:check": "node scripts/validate-frozen-profile.mjs && node scripts/validate-config.mjs && node --test tests/security.test.mjs tests/adversarial-policy.test.mjs tests/keypair-security.test.mjs",
    "security:keys": "node --test tests/keypair-security.test.mjs && pnpm validate:keypairs:devnet && pnpm validate:keypairs:production",
    "start:faucet": "pnpm --filter @powerchain/faucet start",
    "sync:web-public": "node scripts/sync-web-public.mjs",
    "test": "node --test tests/*.test.mjs && pnpm -r test",
    "test:env": "node --test tests/env-validation.test.mjs",
    "test:evidence": "node --test tests/evidence-validation.test.mjs",
    "test:faucet": "pnpm --filter @powerchain/faucet test",
    "test:hardening": "node --test tests/release-hardening.test.mjs",
    "test:policy": "node --test tests/frozen-profile.test.mjs tests/adversarial-policy.test.mjs",
    "test:powerpay": "node scripts/run-rust-tool.mjs test programs/powerpay/Cargo.toml",
    "test:program:rust": "node scripts/run-rust-tool.mjs test programs/native-token/Cargo.toml",
    "test:standards": "pnpm --filter @powerchain/standards test",
    "test:tpwrc": "node --test tests/tpwrc-profile.test.mjs",
    "test:utils": "pnpm --filter @powerchain/utils test",
    "tpwrc:configure": "node scripts/configure-tpwrc-mint.mjs",
    "tpwrc:configure:dry-run": "node scripts/configure-tpwrc-mint.mjs --dry-run",
    "typecheck": "pnpm -r typecheck",
    "typecheck:faucet": "pnpm --filter @powerchain/faucet typecheck",
    "typecheck:web": "pnpm --filter @powerchain/web typecheck",
    "validate": "node scripts/validate-workspace.mjs",
    "validate:config": "node scripts/validate-config.mjs",
    "validate:devnet": "node scripts/validate-env.mjs .env.devnet devnet",
    "validate:evidence": "node scripts/validate-evidence.mjs",
    "validate:faucet": "node scripts/validate-faucet.mjs",
    "validate:frozen": "node scripts/validate-frozen-profile.mjs",
    "validate:keypairs:devnet": "node scripts/validate-keypairs.mjs .env.devnet devnet",
    "validate:keypairs:production": "node scripts/validate-keypairs.mjs .env.production production",
    "validate:mainnet-program": "node scripts/validate-mainnet-program.mjs",
    "validate:packages": "node scripts/validate-package-graph.mjs",
    "validate:powerpay": "node scripts/validate-powerpay.mjs",
    "validate:production": "node scripts/validate-env.mjs .env.production production",
    "validate:routing": "node scripts/validate-routing.mjs",
    "validate:standards": "node scripts/validate-standards.mjs",
    "validate:workspace": "node scripts/validate-workspace.mjs",
    "verify:hosting": "node scripts/verify-hosting.mjs",
    "verify:onchain:devnet": "node scripts/verify-onchain-mint.mjs .env.devnet devnet",
    "verify:onchain:production": "node scripts/verify-onchain-mint.mjs .env.production production",
    "env:bootstrap:devnet": "node scripts/bootstrap-env.mjs devnet",
    "env:bootstrap:production": "node scripts/bootstrap-env.mjs production",
    "env:bootstrap:devnet:force": "node scripts/bootstrap-env.mjs devnet --force",
    "bootstrap": "pnpm workspace:repair && pnpm install --prefer-offline && pnpm preflight",
    "workspace:repair": "node scripts/repair-workspace.mjs",
    "workspace:repair:strict": "node scripts/repair-workspace.mjs --strict",
    "install:repair": "pnpm workspace:repair && pnpm install --force",
    "deps:doctor": "node scripts/dependency-doctor.mjs",
    "deps:repair": "node scripts/repair-workspace.mjs --dependencies && pnpm install --force",
    "preflight": "pnpm workspace:repair:strict && pnpm validate:workspace && pnpm deps:doctor",
    "dev:faucet:debug": "pnpm --filter @powerchain/faucet dev:debug",
    "typecheck:client": "pnpm --filter @powerchain/client typecheck",
    "typecheck:sdk": "pnpm --filter @powerchain/native-token-client typecheck",
    "build:client": "pnpm --filter @powerchain/client build",
    "test:client": "pnpm --filter @powerchain/client test",
    "validate:layout": "node scripts/validate-layout.mjs",
    "validate:workspace-manifest": "node scripts/validate-workspace-manifest.mjs",
    "validate:security-boundaries": "node scripts/validate-security-boundaries.mjs",
    "preinstall": "node scripts/repair-workspace.mjs",
    "validate:rust-workspace": "node scripts/validate-rust-workspace.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "tsx": "^4.20.6"
  },
  "homepage": "https://docs.powerchain.energy",
  "documentation": "https://docs.powerchain.energy"
}
