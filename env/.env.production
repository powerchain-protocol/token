# PowerChain PWRC production profile — safe template only.
# Replace every REQUIRED_* value through the deployment secret manager.
NODE_ENV=production
POWERCHAIN_ENV=production
POWERCHAIN_CLUSTER=mainnet-beta
POWERCHAIN_RPC_PROVIDER=helius
POWERCHAIN_PRODUCTION_DEPLOYMENT=false

# Deployment identifiers. Placeholder program IDs are rejected by production validation.
POWERCHAIN_PROGRAM_ID=REQUIRED_MAINNET_PROGRAM_ID
POWERCHAIN_PWRC_MINT=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc

# Managed RPC. Keep API keys in the deployment platform's secret store.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=REQUIRED_SECRET
HELIUS_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REQUIRED_SECRET
HELIUS_MAINNET_WS_URL=wss://mainnet.helius-rpc.com/?api-key=REQUIRED_SECRET

# Canonical PWRC profile.
PWRC_DECIMALS=9
PWRC_TRANSFER_FEE_BASIS_POINTS=250
PWRC_MAXIMUM_TRANSFER_FEE_TOKENS=1000000
PWRC_TOKEN_PROGRAM_ID=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb

# Public metadata and documentation.
PWRC_METADATA_URI=https://powerchain.energy/metadata/metaplex.json
PWRC_LOGO_PNG_URI=https://powerchain.energy/assets/token/pwrc.png
PWRC_LOGO_SVG_URI=https://powerchain.energy/assets/token/pwrc.svg
POWERCHAIN_DOCS_URL=https://docs.powerchain.energy
POWERCHAIN_EXPLORER=solscan
POWERCHAIN_EXPLORER_BASE_URL=https://solscan.io
SOLSCAN_API_KEY=REQUIRED_SECRET

# Observational integrations; never authoritative for supply accounting.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_PWRC_USD_FEED_ID=REQUIRED_APPROVED_FEED_ID
PYTH_MAX_PRICE_AGE_SECONDS=60
PYTH_MAX_CONFIDENCE_BPS=100
BIRDEYE_API_KEY=REQUIRED_SECRET
BIRDEYE_BASE_URL=https://public-api.birdeye.so
TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
TOKEN_2022_PROGRAM_ID=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
ASSOCIATED_TOKEN_PROGRAM_ID=ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL
MEMO_PROGRAM_ID=MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr
PWRC_MINT=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc
# Mainnet integration controls
POWERCHAIN_MAINNET_INTEGRATIONS_ENABLED=true
POWERCHAIN_PROVIDER_TIMEOUT_MS=10000
POWERCHAIN_PROVIDER_MAX_RETRIES=2
BIRDEYE_CHAIN=solana
SOLSCAN_BASE_URL=https://solscan.io
