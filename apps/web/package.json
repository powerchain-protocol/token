{
  "name": "@powerchain/web",
  "version": "1.0.0-rc.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-next.mjs dev -p 3005",
    "build": "node ../../scripts/run-next.mjs build",
    "start": "node ../../scripts/run-next.mjs start -p 3005",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next",
    "deps:build": "pnpm --filter @powerchain/standards build && pnpm --filter @powerchain/native-token-client build",
    "predev": "pnpm run deps:build",
    "prebuild": "pnpm run deps:build"
  },
  "dependencies": {
    "@powerchain/native-token-client": "workspace:*",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "next": "^16.2.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tweetnacl": "^1.0.3",
    "@tailwindcss/postcss": "^4.1.14",
    "tailwindcss": "^4.1.14",
    "@powerchain/standards": "workspace:*",
    "@web3icons/react": "^4.0.15",
    "@radix-ui/react-icons": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^7.0.2"
  }
}
